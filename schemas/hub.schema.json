{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/falcon-autotuning/instrument-server/runtime/internal/config/hub-config",
  "$ref": "#/$defs/HubConfig",
  "$defs": {
    "APIParseCharacteristic": {
      "properties": {
        "command": {
          "type": "string"
        },
        "parameterName": {
          "type": "string"
        },
        "reducer": {
          "$ref": "#/$defs/Reducer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CharacteristicIdentifier": {
      "type": "string",
      "enum": [
        "ac_amplitude",
        "current_ramp_slope",
        "magnet_strength",
        "max_ac_amplitude",
        "max_current_ramp_slope",
        "max_magnet_strength",
        "max_number_of_samples",
        "max_sample_rate",
        "max_sink_frequency",
        "max_source_current",
        "max_source_frequency",
        "max_source_voltage",
        "max_voltage_ramp_slope",
        "min_ac_amplitude",
        "min_current_ramp_slope",
        "min_magnet_strength",
        "min_number_of_samples",
        "min_sample_rate",
        "min_sink_frequency",
        "min_source_current",
        "min_source_frequency",
        "min_source_voltage",
        "min_voltage_ramp_slope",
        "number_of_samples",
        "sample_rate",
        "sink_frequency",
        "source_current",
        "source_frequency",
        "source_voltage",
        "temperature",
        "voltage_ramp_slope"
      ]
    },
    "DatabaseConfig": {
      "properties": {
        "local-database": {
          "type": "string"
        },
        "local-cache": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "local-database",
        "local-cache",
        "owner"
      ]
    },
    "HubConfig": {
      "properties": {
        "wiremap": {
          "items": {
            "$ref": "#/$defs/WiremapEntry"
          },
          "type": "array",
          "description": "Logical to physical connection mappings"
        },
        "quantum-dot-config": {
          "type": "string",
          "description": "Global Path to the quantum dot config describing the device loaded"
        },
        "initial-voltage-state": {
          "$ref": "#/$defs/VoltageStates",
          "description": "Initial Voltage state to allow for connecting to running devices without shocking. defaults to 0V"
        },
        "nats": {
          "$ref": "#/$defs/NatsConfig",
          "description": "NATSURL for establishing communications i.e. nats://derek:pass@localhost:4222"
        },
        "database": {
          "$ref": "#/$defs/DatabaseConfig",
          "description": "Database configuration information"
        },
        "working-directory": {
          "type": "string",
          "description": "Global Path for location of all logging to be deposited"
        },
        "user-measurement-luas": {
          "type": "string",
          "description": "Global Path to measurement scripts directory"
        },
        "instrument-server": {
          "$ref": "#/$defs/InstrumentServerConfig",
          "description": "Configuration for the Instrument Script Server"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "wiremap",
        "quantum-dot-config",
        "initial-voltage-state",
        "nats",
        "database",
        "working-directory",
        "user-measurement-luas",
        "instrument-server"
      ]
    },
    "InstrumentCharacteristic": {
      "properties": {
        "identifier": {
          "$ref": "#/$defs/CharacteristicIdentifier"
        },
        "readCommand": {
          "$ref": "#/$defs/APIParseCharacteristic"
        },
        "writeCommand": {
          "$ref": "#/$defs/APIParseCharacteristic"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "identifier",
        "readCommand",
        "writeCommand"
      ]
    },
    "InstrumentConfig": {
      "properties": {
        "config": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/InstrumentType"
        },
        "characteristics": {
          "items": {
            "$ref": "#/$defs/InstrumentCharacteristic"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "config",
        "plugin",
        "type",
        "characteristics"
      ]
    },
    "InstrumentServerConfig": {
      "properties": {
        "rpc-port": {
          "type": "integer"
        },
        "autostart": {
          "type": "boolean",
          "description": "AutoStart indicates if the hub owns the ISS or if it is persisiting in the background. If the hub owns the ISS then it is responsible for shutting it down"
        },
        "instruments": {
          "items": {
            "$ref": "#/$defs/InstrumentConfig"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "rpc-port",
        "autostart",
        "instruments"
      ]
    },
    "InstrumentType": {
      "type": "string",
      "enum": [
        "amnmeter",
        "clock",
        "current_source",
        "dc_current_source",
        "dc_voltage_source",
        "discrete",
        "fpga",
        "hf_current_source",
        "hf_voltage_source",
        "lockin",
        "magnet",
        "thermometer",
        "voltage_source",
        "voltmeter"
      ]
    },
    "NatsConfig": {
      "properties": {
        "host": {
          "type": "string",
          "description": "The host address for the nats server. Default is localhost"
        },
        "port": {
          "type": "integer",
          "description": "The port for the nats server. Default is whatever is available"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "host",
        "port"
      ]
    },
    "Reducer": {
      "type": "string",
      "enum": [
        "min",
        "max"
      ]
    },
    "VoltageState": {
      "properties": {
        "voltage": {
          "type": "number",
          "description": "The starting voltage value on the device"
        },
        "name": {
          "type": "string",
          "description": "The name of the device connection"
        },
        "unit": {
          "type": "integer",
          "description": "The unit of the applied voltage (volt, millivolt, microvolt)"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "voltage",
        "name",
        "unit"
      ]
    },
    "VoltageStates": {
      "items": {
        "$ref": "#/$defs/VoltageState"
      },
      "type": "array"
    },
    "WiremapEntry": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Logical device connection name, for example P1, B2, or O1"
        },
        "instrument": {
          "$ref": "#/$defs/WiremapInstrument"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "instrument"
      ]
    },
    "WiremapInstrument": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Instrument instance name, for example Source1 or Meter1"
        },
        "channel_group": {
          "type": "string",
          "description": "Instrument channel group family used i.e. Analog"
        },
        "index": {
          "type": "integer",
          "description": "Physical channel index i.e. 1"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "channel_group",
        "index"
      ]
    }
  }
}