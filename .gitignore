
# ignore testing data
/test-outs
*.npz
*.npy
*.h5
*.db

# ignore vcpkg data installed in Makefile
/vcpkg
/vcpkg_installed

# ignore build
/build

# ignore local data files: data, datacache, log files, etc. from falcon/iss/hub
/log
/datacache
/data

# Nested runtime output and legacy Go build locations.
/runtime/log/
/runtime/data/
/runtime/datacache/
/runtime/main
/runtime/cmd/main
/runtime/dataviewer
/runtime/main.exe
/runtime/cmd/main.exe
/runtime/dataviewer.exe
/nohup.out
*.db-shm
*.db-wal

.aider*
*/__pycache__/*
*/bin/*
